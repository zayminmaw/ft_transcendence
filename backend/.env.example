NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=transcend_user
DB_PASS=replace-with-the-same-password-as-the-root-env
DB_NAME=transcend_db
JWT_SECRET=replace-with-the-same-secret-as-the-root-env
JWT_ISSUER=transcend
JWT_AUDIENCE=transcend-web
# 42 login (optional). Register <CORS_ORIGIN>/api/auth/42/callback as a redirect URI on the 42 app.
FORTYTWO_APP_ID=
FORTYTWO_APP_SECRET=
# Technical logs: LOG_LEVEL is fatal|error|warn|info|debug|verbose; LOG_FORMAT=pretty for a readable local terminal.
LOG_LEVEL=info
LOG_FORMAT=json
