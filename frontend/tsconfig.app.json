{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@app/*": ["src/app/*"], "@components": ["src/components/index.ts"], "@hooks/*": ["src/hooks/*"], "@services/*": ["src/services/*"], "@utils/*": ["src/utils/*"], "@modules/*": ["src/modules/*"] }
  },
  "include": ["src"]
}
